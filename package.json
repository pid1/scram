{
  "name": "scram",
  "version": "0.1.0",
  "description": "A spend kill switch for Cloudflare accounts. Estimates billable usage in near-real time and shuts the account down before the bill runs away.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 migrations apply scram --remote",
    "db:migrate:local": "wrangler d1 migrations apply scram --local",
    "setup": "./scripts/setup.sh"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  },
  "overrides": {
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  }
}
